# ========================================
# DATABASE CONFIGURATION
# ========================================
# Nie zmieniaj - Docker PostgreSQL będzie działać na tych danych
DATABASE_URL="postgresql://studymate_user:studymate_pass@localhost:5432/studymate_db"

# ========================================
# NEXTAUTH CONFIGURATION (Autentykacja)
# ========================================
# URL aplikacji (lokalny development)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# WAŻNE: Wygeneruj nowy secret dla produkcji!
# Na lokalny development możesz użyć dowolnego stringa
# Dla produkcji: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-for-production

# ========================================
# AI PROVIDER CONFIGURATION
# ========================================
# Wybierz dostawcę: openai, gemini, claude, mistral, cohere
# Domyślnie: openai
AI_PROVIDER=openai

# ========================================
# AI API KEYS - WYBIERZ CO NAJMNIEJ JEDNEGO
# ========================================
# OpenAI - https://platform.openai.com/api-keys
# Free credits: $5 dla nowych kont
OPENAI_API_KEY=

# Google Gemini - https://aistudio.google.com/app/apikey
# DARMOWY! (rekomendujemy dla developmentu)
GEMINI_API_KEY=

# Anthropic Claude - https://console.anthropic.com/
# Free credits: $5 dla nowych kont
CLAUDE_API_KEY=

# Mistral AI - https://console.mistral.ai/
# Free tier dostępny
MISTRAL_API_KEY=

# Cohere - https://dashboard.cohere.com/
# Free tier: 100 req/min
COHERE_API_KEY=
